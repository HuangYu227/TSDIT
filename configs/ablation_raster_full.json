{
    "data": {
        "representation": "row_raster",
        "patch_size": 8,
        "dataset_type": "csv",
        "datasets": ["ETTh1"],
        "time_interval": 24,
        "image_size": 64,
        "n_fft": 64,
        "hop_length": 16,
        "decode_mode": "row_raster"
    },
    "diffusion": {
        "in_channels": 1,
        "channels": 128,
        "nheads": 8,
        "layers": 8,
        "diffusion_embedding_dim": 256,
        "base_patch": 2,
        "condition_type": "adaLN"
    },
    "condition": {
        "cond_mode": "text_image",
        "decode_scale_mode": "global",
        "reference": {
            "mode": "masked_self",
            "mask_layout": "row_major",
            "mask_ratio": 0.5,
            "noise_std": 0.02,
            "fill": 0.5
        },
        "image": {
            "encoder": "vit",
            "in_channels": 1,
            "patch_size": 2,
            "embed_dim": 256,
            "depth": 4,
            "num_heads": 8
        }
    },
    "csa_moe": { "enabled": true, "k": 1, "alpha": 0.01, "inject_aux": false },
    "cticd": {
        "enabled": true,
        "d_model": 128,
        "n_channels": 1,
        "n_mechanisms_per_channel": 4,
        "n_segments": 8,
        "max_lag": 2,
        "patch_size": 2,
        "num_heads": 8,
        "edge_bias": -4.0,
        "lag_edge_bias": -2.5,
        "branch_grad_scale": 0.2,
        "lambda_causal": 1.0,
        "lambda_notears": 0.05,
        "lambda_sparsity": 1e-2,
        "lambda_smooth": 1e-3,
        "lambda_prior": 0.1,
        "use_lag_prior": true,
        "lag_prior_method": "acf",
        "lag_prior_mode": "bias_gate",
        "lag_prior_strength": 1.0,
        "lag_prior_significance": true,
        "lag_prior_bins": 16,
        "signal_length": 24
    }
}
